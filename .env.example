# =====================================
# Patchfly — Environment Configuration
# Copy to .env and adjust
# =====================================

# --- Server ---
PATCHFLY_HOST=0.0.0.0
PATCHFLY_PORT=8080
PATCHFLY_BASE_URL=https://api.patchfly.dev
PATCHFLY_ENV=production

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://patchfly:changeme@localhost:5432/patchfly
DATABASE_MAX_CONNECTIONS=10
# SSL mode: disable / require / verify-full. Default: disable
DATABASE_SSL_MODE=disable
# Auto-apply schema.sql on startup if tables are missing (default: true)
# Set to false if you manage migrations externally (e.g. with Flyway / sqitch)
RUN_MIGRATIONS=true
# Optional: override the schema file location. By default the server
# looks for lib/db/schema.sql relative to the working directory,
# and falls back to /app/schema.sql in the Docker image.
SCHEMA_PATH=

# --- Auth ---
# Generate with: openssl rand -hex 64
JWT_SECRET=replace-with-64-bytes-of-random-hex
JWT_EXPIRY_HOURS=720

# --- Storage ---
# Backend: local | s3
# Default: local (files in STORAGE_PATH)
# For production, use s3 with any S3-compatible service.
STORAGE_BACKEND=local
STORAGE_PATH=/var/patchfly/storage
# Maks ukuran patch (MB)
MAX_PATCH_SIZE_MB=200

# --- S3 / S3-compatible (only when STORAGE_BACKEND=s3) ---
# Works with AWS S3, MinIO, Cloudflare R2, Backblaze B2, Wasabi, DO Spaces, etc.
S3_BUCKET=patchfly-patches
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_USE_SSL=true
# Create the bucket automatically if it doesn't exist (default: true)
S3_AUTO_CREATE_BUCKET=true
# Optional: if set, the SDK will be told to download patches directly
# from this URL instead of proxying through the Patchfly server.
# Examples:
#   https://cdn.example.com           (CloudFront/Cloudflare CDN in front of S3)
#   https://patchfly-patches.s3.amazonaws.com
# Leave empty to always proxy through Patchfly.
S3_PUBLIC_URL=

# --- Signing ---
# Ed25519 key pair for signing patches.
# Generate with: dart run tool/gen_signing_keys.dart (from server/)
PATCH_SIGNING_PUBLIC_KEY=
PATCH_SIGNING_PRIVATE_KEY=

# --- CORS ---
# Comma-separated origins (atau * untuk dev)
CORS_ORIGINS=*

# --- Logging ---
LOG_LEVEL=info
